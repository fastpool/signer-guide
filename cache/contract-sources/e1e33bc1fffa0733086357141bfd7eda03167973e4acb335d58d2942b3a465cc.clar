(impl-trait 'SP000000000000000000002Q6VF78.pox-5.signer-manager-trait)
(use-trait signer-manager-trait 'SP000000000000000000002Q6VF78.pox-5.signer-manager-trait)
(define-constant ERR_UNAUTHORIZED_ADMIN (err u42001))
(define-constant ERR_STAKER_NOT_ALLOWED (err u42002))
(define-constant ERR_FEE_TOO_HIGH (err u42003))
(define-constant ERR_NOT_DIRECT (err u42005))
(define-constant ERR_NOT_STREAMING (err u42006))
(define-constant ERR_NO_CLAIMABLE_REWARDS (err u42007))
(define-constant ERR_NOT_KEEPER (err u42008))
(define-constant DENOMINATOR_BPS u10000)
(define-constant MODE-DIRECT u0)
(define-data-var fee-bps uint u250)
(define-data-var fee-receiver principal tx-sender)
(define-read-only (is-admin (who principal))
  (contract-call? .signer-admin-v1 is-admin current-contract who)
)
(define-read-only (get-fee-bps) (var-get fee-bps))
(define-read-only (get-fee-receiver) (var-get fee-receiver))
(define-read-only (get-fee-split (earned uint))
  (let ((fee (/ (* earned (var-get fee-bps)) DENOMINATOR_BPS)))
    { fee: fee, net: (- earned fee) }
  )
)
(define-public (validate-stake!
    (staker principal)
    (first-index uint)
    (num-indexes uint)
    (amount-ustx uint)
    (amount-sats uint)
    (is-bond bool)
    (signer-calldata (optional (buff 500)))
  )
  (begin
    (asserts! (contract-call? .native-pool-v2 is-delegating staker current-contract) ERR_STAKER_NOT_ALLOWED)
    (ok true)
  )
)
(define-public (register-self
    (signer-manager <signer-manager-trait>)
    (signer-key (buff 33))
    (auth-id uint)
    (signer-sig (buff 65))
  )
  (begin
    (try! (authorize-admin))
    (try! (as-contract?
      ()
      (try! (contract-call? 'SP000000000000000000002Q6VF78.pox-5 grant-signer-key signer-key current-contract auth-id signer-sig))
      (try! (contract-call? 'SP000000000000000000002Q6VF78.pox-5 register-signer signer-manager signer-key))
    ))
    (print { action: "register-self", data: { signer-key: signer-key, block-height: stacks-block-height } })
    (ok true)
  )
)
(define-public (claim-rewards
    (bond-periods (list 6 uint))
    (reward-cycle uint)
  )
  (let (
    (info (try! (as-contract? ()
      (try! (contract-call? 'SP000000000000000000002Q6VF78.pox-5 claim-rewards bond-periods reward-cycle))
    )))
  )
    (print { action: "claim-rewards", data: { total-rewards: (get total-rewards info), reward-cycle: reward-cycle, block-height: stacks-block-height } })
    (ok info)
  )
)
(define-public (claim-staker-rewards
    (reward-cycle uint)
    (bond-index (optional uint))
  )
  (let (
    (staker tx-sender)
  )
    (asserts! (is-eq (get mode (contract-call? .native-pool-v2 get-user-prefs staker)) MODE-DIRECT) ERR_NOT_DIRECT)
    (let (
      (earned (try! (settle-staker staker reward-cycle bond-index)))
      (net (try! (skim-fee staker earned)))
    )
      (try! (send-sbtc net staker))
      (print { action: "claim-staker-rewards", data: { staker: staker, earned: earned, net: net, cycle: reward-cycle, block-height: stacks-block-height } })
      (ok net)
    )
  )
)
(define-public (claim-staker-to-custody
    (staker principal)
    (reward-cycle uint)
    (bond-index (optional uint))
  )
  (begin
    (try! (check-custody-caller staker))
    (custody-claim-one staker reward-cycle bond-index)
  )
)
(define-public (claim-staker-to-custody-many (staker principal) (cycles (list 64 uint)))
  (begin
    (try! (check-custody-caller staker))
    (let (
      (total (get total (try! (fold custody-claim-fold cycles (ok { staker: staker, total: u0 })))))
    )
      (print { action: "claim-staker-to-custody-many", data: { staker: staker, total: total, cycles: (len cycles), block-height: stacks-block-height } })
      (ok total)
    )
  )
)
(define-public (set-fee-bps (bps uint))
  (begin
    (try! (contract-call? .dao check-is-protocol contract-caller))
    (asserts! (< bps DENOMINATOR_BPS) ERR_FEE_TOO_HIGH)
    (var-set fee-bps bps)
    (print { action: "set-fee-bps", data: { bps: bps, block-height: stacks-block-height } })
    (ok true)
  )
)
(define-public (set-fee-receiver (who principal))
  (begin
    (try! (contract-call? .dao check-is-protocol contract-caller))
    (var-set fee-receiver who)
    (print { action: "set-fee-receiver", data: { who: who, block-height: stacks-block-height } })
    (ok true)
  )
)
(define-private (settle-staker (staker principal) (reward-cycle uint) (bond-index (optional uint)))
  (let (
    (earned (get earned (try! (contract-call? 'SP000000000000000000002Q6VF78.pox-5 claim-staker-rewards-for-signer staker reward-cycle bond-index))))
  )
    (asserts! (> earned u0) ERR_NO_CLAIMABLE_REWARDS)
    (ok earned)
  )
)
(define-private (custody-claim-one (staker principal) (reward-cycle uint) (bond-index (optional uint)))
  (let (
    (earned (try! (settle-staker staker reward-cycle bond-index)))
    (net (try! (skim-fee staker earned)))
  )
    (try! (send-sbtc net .native-reward-streamer-v2))
    (try! (contract-call? .native-reward-streamer-v2 record-credit staker net))
    (print { action: "claim-staker-to-custody", data: { staker: staker, earned: earned, net: net, cycle: reward-cycle, block-height: stacks-block-height } })
    (ok net)
  )
)
(define-private (custody-claim-fold
    (cycle uint)
    (acc (response { staker: principal, total: uint } uint))
  )
  (let (
    (a (try! acc))
    (staker (get staker a))
  )
    (if (is-eq (contract-call? 'SP000000000000000000002Q6VF78.pox-5 get-earned-staker-rewards current-contract cycle none staker) u0)
      (ok a)
      (ok (merge a { total: (+ (get total a) (try! (custody-claim-one staker cycle none))) }))
    )
  )
)
(define-private (skim-fee (staker principal) (earned uint))
  (let (
    (split (get-fee-split earned))
    (fee (get fee split))
  )
    (if (> fee u0)
      (begin
        (try! (send-sbtc fee (var-get fee-receiver)))
        (print { action: "fee-skimmed", data: { staker: staker, fee: fee, receiver: (var-get fee-receiver), block-height: stacks-block-height } })
        (ok (get net split))
      )
      (ok (get net split))
    )
  )
)
(define-private (send-sbtc (amount uint) (recipient principal))
  (begin
    (try! (as-contract?
      ((with-ft 'SM3VDXK3WZZSA84XXFKAFAF15NNZX32CTSG82JFQ4.sbtc-token "sbtc-token" amount))
      (try! (contract-call? 'SM3VDXK3WZZSA84XXFKAFAF15NNZX32CTSG82JFQ4.sbtc-token transfer amount current-contract recipient none))
    ))
    (ok true)
  )
)
(define-private (check-custody-caller (staker principal))
  (begin
    (asserts! (contract-call? .native-reward-streamer-v2 is-keeper contract-caller) ERR_NOT_KEEPER)
    (asserts! (not (is-eq (get mode (contract-call? .native-pool-v2 get-user-prefs staker)) MODE-DIRECT)) ERR_NOT_STREAMING)
    (ok true)
  )
)
(define-private (authorize-admin)
  (ok (asserts! (and (is-eq contract-caller tx-sender) (is-admin tx-sender)) ERR_UNAUTHORIZED_ADMIN))
)
