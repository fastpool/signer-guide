node_modules/
.expo/
dist/
web-build/
expo-env.d.ts

# `android/` is generated by `expo prebuild`, and is committed anyway.
#
# F-Droid builds it. Their builder checks out the tag and fails with "Missing
# subdir" before it runs a single command of ours, so the native project has to
# be in the tree already — and a `npx expo prebuild` at build time would hand
# them a project generated by whatever Expo resolves to that day, which is the
# opposite of a reproducible build.
#
# The cost is that app.json is no longer the only place the manifest, the icons
# and the version live. `npm run prebuild:check` fails if the two have drifted.
# Build output inside it stays ignored by android/.gitignore, which Expo writes.
#
# `ios/` has no such consumer and stays generated.
/ios/

# Native
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Metro
.metro-health-check*

# Debug
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# macOS
.DS_Store

# Test output
e2e-report.xml
coverage/

# Composed by the release workflow from store/screenshots/play
store/play/*/images/
