node_modules/
.expo/
dist/
web-build/
expo-env.d.ts

# Generated by `expo prebuild` from app.json and the config plugins. Committing
# them would mean two places to change the manifest, and the second one wins.
#
# Anchored with a leading slash on purpose: a bare `android/` matches every
# directory of that name at any depth, and swallowed
# `fastlane/metadata/android/`, which is the listing F-Droid reads out of this
# repository.
/android/
/ios/

# Native
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Metro
.metro-health-check*

# Debug
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# macOS
.DS_Store

# Test output
e2e-report.xml
coverage/

# Composed by the release workflow from store/screenshots/play
store/play/*/images/
