{
  "name": "signer-guide-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --platform android",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "e2e": "maestro test e2e",
    "e2e:record": "maestro test --format junit --output e2e-report.xml e2e"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.0",
    "@react-navigation/native-stack": "^7.3.0",
    "@stacks/bitcoin-staking": "^7.6.0",
    "@stacks/network": "^7.6.0",
    "@stacks/transactions": "^7.6.0",
    "@walletconnect/react-native-compat": "^2.22.0",
    "@walletconnect/universal-provider": "^2.22.0",
    "expo": "~57.0.17",
    "expo-application": "~57.0.0",
    "expo-clipboard": "~57.0.0",
    "expo-constants": "~57.0.0",
    "expo-crypto": "~57.0.0",
    "expo-linking": "~57.0.0",
    "expo-status-bar": "~57.0.1",
    "minidenticons": "^4.2.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "babel-plugin-dynamic-import-node": "^2.3.3",
    "babel-plugin-module-resolver": "^5.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.0",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(?:.pnpm/)?((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|react-native-svg|react-native-get-random-values|@walletconnect/.*|minidenticons|@stacks/.*|@scure/.*|@noble/.*|micro-packed|uint8array-tools|uint8arrays|multiformats|ox|abitype|@msgpack/.*|blakejs|detect-browser))"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/e2e/",
      "<rootDir>/node_modules/"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}"
    ],
    "resolver": "<rootDir>/jest.resolver.js"
  }
}
