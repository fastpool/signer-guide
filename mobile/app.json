{
  "expo": {
    "name": "Signer Guide",
    "slug": "signer-guide",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "signerguide",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#403374"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.fastpool.signerguide"
    },
    "android": {
      "package": "org.fastpool.signerguide",
      "adaptiveIcon": {
        "backgroundColor": "#403374",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "signerguide"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withWalletQueries",
      "expo-font",
      "./plugins/withReleaseSigning"
    ],
    "extra": {
      "walletConnectProjectId": "a013ec0fd2d07ac0ba6c2e2512fd8a23"
    }
  }
}
